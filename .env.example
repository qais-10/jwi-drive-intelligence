# --- Vendor approval automation (monday.com) ---
# Board/group/column IDs already default (in app/config.py) to the JWI
# "Vendor" board (id 5100825568, CRM workspace) -- only override below if
# pointing at a different board. The Approved/Rejected -> group move is
# handled by native monday.com board automations, not this service.
# Run `python -m scripts.setup_monday_board` only to provision a new board.

MONDAY_API_TOKEN=

# Shared secret sent as the X-Cron-Secret header by the scheduled job
# that calls POST /cron/vendor-deadlines
CRON_SECRET=

SLACK_BOT_TOKEN=
SLACK_CHANNEL_OPS=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=

VENDOR_FORM_URL=

# Optional AI-augmented completeness review. Leave blank to fall back to
# the deterministic required-field check only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Comma-separated list, e.g. company_name,contact_name,contact_email,tax_id
VENDOR_REQUIRED_FIELDS=

APPROVAL_DEADLINE_BUSINESS_DAYS=5
