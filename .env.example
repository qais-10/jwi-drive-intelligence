MONDAY_COL_MISSING_FIELDS=
MONDAY_COL_AI_NOTES=
MONDAY_COL_APPROVAL_STATUS=
MONDAY_COL_APPROVAL_DEADLINE=
MONDAY_COL_LAST_REMINDER_SENT=

# Shared secret appended as ?token=... to the monday.com webhook URL
MONDAY_WEBHOOK_SECRET=

# Shared secret sent as the X-Cron-Secret header by the scheduled job
# that calls POST /cron/vendor-deadlines
CRON_SECRET=

SLACK_BOT_TOKEN=
SLACK_CHANNEL_OPS=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=

VENDOR_FORM_URL=

