# --- Vendor approval automation (monday.com) ---
# Run `python -m scripts.setup_monday_board` after setting MONDAY_API_TOKEN
# to create the board and print the MONDAY_GROUP_*/MONDAY_COL_* values below.

MONDAY_API_TOKEN=
MONDAY_BOARD_ID=

MONDAY_GROUP_NEW_SUBMISSION=
MONDAY_GROUP_UNDER_REVIEW=
MONDAY_GROUP_APPROVED_VENDOR=
MONDAY_GROUP_ARCHIVED=

